# Run python -m scripts.init_local to generate unique local secrets in .env.
APP_ENV=local
AUTH_MODE=local
LOCAL_API_TOKEN=
AGENT_MODE=mock
SQL_HOST=127.0.0.1
SQL_PORT=14339
SQL_DATABASE=SQLIntelligence
SQL_USERNAME=sql_runtime
SQL_PASSWORD=
SQL_ADMIN_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUST_CERTIFICATE=true
SQL_MANAGED_IDENTITY=false
SQL_EXPECTED_PRINCIPAL=sql_runtime
QUERY_TIMEOUT_SECONDS=10
MAX_CONCURRENT_QUERIES=3
MAX_RESULT_ROWS=500
MAX_RESULT_BYTES=262144
API_URL=http://127.0.0.1:8000
# Azure configuration is opt-in. No resources are created by the application.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_TOKEN_SCOPE=https://ai.azure.com/.default
AZURE_OPENAI_TIMEOUT_SECONDS=30
AZURE_OPENAI_MAX_OUTPUT_TOKENS=4000
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_ALLOWED_OBJECT_IDS=[]
ENTRA_REQUIRED_SCOPE=access_as_user
