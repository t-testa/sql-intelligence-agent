# Copy privately to .local/cloud-runtime.env on the approved migration host.
# Never replace the local Docker .env. Runtime containers receive these through Bicep.
APP_ENV=cloud
AUTH_MODE=entra
AGENT_MODE=azure
APPLICATION_ACCESS_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_FRONTEND_CLIENT_ID=
ENTRA_ALLOWED_OBJECT_IDS=[]
ENTRA_REQUIRED_SCOPE=access_as_user
SQL_HOST=
SQL_PORT=1433
SQL_DATABASE=SQLIntelligence
SQL_MANAGED_IDENTITY=true
SQL_TRUST_CERTIFICATE=false
SQL_EXPECTED_PRINCIPAL=sql_runtime
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=sql-agent-model
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MAX_OUTPUT_TOKENS=1000
AZURE_OPENAI_REQUESTS_PER_MINUTE=6
AZURE_OPENAI_TOKENS_PER_MINUTE=18000
AZURE_OPENAI_DAILY_REQUEST_LIMIT=100
